                    INSERT OR IGNORE INTO settings (key, value) VALUES ('last_playlist', '');
                    INSERT OR IGNORE INTO settings (key, value) VALUES ('last_playlist_path', '');
                    INSERT OR IGNORE INTO settings (key, value) VALUES ('last_epg_file', '');
